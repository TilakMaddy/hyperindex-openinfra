# Seed one env's 1Password items with placeholders; omit it to pick one.
seed-vault env="":
    ./scripts/seed-vault.sh {{ env }}

# Bootstrap the flux entrypoint for an <env>/<cluster>; omit it to pick one.
bootstrap target="":
    ./scripts/bootstrap.sh {{ target }}

# Print an <env>/<cluster>'s grafana, hasura and postgres logins; omit it to pick one.
show-details target="":
    ./scripts/show-details.sh {{ target }}

# Tear an <env>/<cluster> down ahead of terraform destroy; omit it to pick one.
destroy target="":
    ./scripts/destroy.sh {{ target }}
